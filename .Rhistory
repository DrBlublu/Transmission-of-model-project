df <- read.csv("../data/processed/data.csv", header = TRUE, row.names = 1)
df <- tibble(df)
df$cond <- as.factor(df$cond)
df_parent <- df %>% filter(gen != 0)
# Step 1: Make sure df already has the n_child column
df_with_counts <- df %>%
group_by(parent_ID) %>%
summarise(n_child = n(), .groups = "drop") %>%
right_join(df, by = c("parent_ID" = "ID")) %>%
rename(parent_n_child = n_child)
# Step 2: Join to get each child’s n_child value as well
df_corr <- df_with_counts %>%
left_join(
df_with_counts %>%
select(ID, child_n_child = parent_n_child),
by = c("ID")
) %>%
select(ID, parent_ID, parent_n_child, child_n_child)
View(df_with_counts)
