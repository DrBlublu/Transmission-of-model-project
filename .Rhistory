# Summary of the model
summary(gam_model)
library(mgcv)
library(ggplot2)
library(dplyr)
# Fit the GAM for the ADV condition
df_adv <- df_test %>% filter(cond == "ADV")
gam_model <- gam(avg_n_grandchild ~ s(n_child, k = 5), data = df_adv)
# Summary of the model
summary(gam_model)
# Visualization
ggplot(df_adv, aes(x = n_child, y = avg_n_grandchild)) +
geom_point(alpha = 0.6) +
geom_line(aes(y = predict(gam_model)), color = "darkred", size = 1) +
labs(
title = "Nonlinear Relationship Between Children and Grandchildren (ADV)",
x = "Number of Children",
y = "Average Number of Grandchildren"
) +
theme_minimal()
