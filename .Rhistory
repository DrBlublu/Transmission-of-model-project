library(tidyverse)
library(ggplot2)
library(lme4)
library(lmerTest)
library(effsize)
library(lmtest)
library(sandwich)
library(performance)
df <- read.csv("../data/processed/data.csv", header = TRUE, row.names = 1)
df <- tibble(df)
df$cond <- as.factor(df$cond)
df_parent <- df %>% filter(gen != 0)
child_counts <- df %>%
group_by(parent_ID) %>%
summarise(n_child = n(), .groups = "drop")
df_test <- df %>%
left_join(child_counts, by = c("ID" = "parent_ID")) %>%
mutate(n_child = ifelse(is.na(n_child), 0, n_child))
avg_grandchild_count <- df_test %>%
group_by(parent_ID) %>%
summarise(avg_n_grandchild = mean(n_child), .groups = "drop")
df_test <- df_test %>%
left_join(avg_grandchild_count, by = c("ID" = "parent_ID")) %>%
mutate(avg_n_grandchild = ifelse(is.na(avg_n_grandchild), 0, avg_n_grandchild))
df_test <- df_test %>%
filter(n_child != 0)
cor.test(
df_test %>% filter(cond == "ADV") %>% pull(n_child),
df_test %>% filter(cond == "ADV") %>% pull(avg_n_grandchild),
method="s"
)
cor.test(
df_test %>% filter(cond == "OBS") %>% pull(n_child),
df_test %>% filter(cond == "OBS") %>% pull(avg_n_grandchild),
method="s"
)
cor.test(
df_test %>% filter(cond == "ADV") %>% filter(gen > 8) %>% pull(n_child),
df_test %>% filter(cond == "ADV") %>% filter(gen > 8) %>% pull(avg_n_grandchild),
method="s"
)
cor.test(
df_test %>% filter(cond == "ADV") %>% filter(gen > 8) %>% pull(n_child),
df_test %>% filter(cond == "ADV") %>% filter(gen > 8) %>% pull(avg_n_grandchild),
method="s"
)
cor.test(
df_test %>% filter(cond == "ADV") %>% filter(gen > 7) %>% pull(n_child),
df_test %>% filter(cond == "ADV") %>% filter(gen > 7) %>% pull(avg_n_grandchild),
method="s"
)
df_test %>% filter(cond == "ADV") %>% filter(gen > 7) %>% pull(n_child)
df_test %>% filter(cond == "OBS") %>% filter(gen > 7) %>% pull(n_child)
df_test %>% filter(cond == "OBS") %>% pull(n_child)
df_test %>% filter(cond == "ADV") %>% pull(n_child)
df_test %>% filter(cond == "OBS") %>% filter(gen > 5) %>% pull(n_child)
cor.test(
df_test %>% filter(cond == "ADV") %>% filter(gen > 5) %>% pull(n_child),
df_test %>% filter(cond == "ADV") %>% filter(gen > 5) %>% pull(avg_n_grandchild),
method="s"
)
cor.test(
df_test %>% filter(cond == "OBS") %>% filter(gen > 5) %>% pull(n_child),
df_test %>% filter(cond == "OBS") %>% filter(gen > 5) %>% pull(avg_n_grandchild),
method="s"
)
plot(
df_test %>% filter(cond == "ADV") %>% filter(gen > 5) %>% pull(n_child),
df_test %>% filter(cond == "ADV") %>% filter(gen > 5) %>% pull(avg_n_grandchild)
)
df_test %>%
filter(cond == "ADV") %>%
ggplot(aes(x = n_child, y = avg_n_grandchild)) +
geom_point() +
geom_smooth(method = "lm", se = FALSE) +
labs(
title = "Regression of Avg Grandchildren on Number of Children (ADV Condition)",
x = "Number of Children",
y = "Average Number of Grandchildren"
) +
theme_minimal()
