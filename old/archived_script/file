# param  : df_raw A tibble
# return : df_binary A tibble
df_binary <- df_raw %>%
group_by(PROLIFIC_PID) %>%
filter(trials.ran == 1) %>%
select(
PROLIFIC_PID,
globa_score,
t_points,
t_step1_stimLeft_reward,
t_step1_stimRight_reward,
filename
) %>%
rename(
"ID" = "PROLIFIC_PID",
"score" = "globa_score",
"rew_choice" = "t_points",
"rew_1" = "t_step1_stimLeft_reward",
"rew_2" = "t_step1_stimRight_reward"
) %>%
mutate(n_trial = 1:n()) %>%
mutate(best = pmax(rew_1, rew_2)) %>%
mutate(binary_score = ifelse(rew_choice == best, 1, 0)) %>%
summarise(
filename = unique(filename),
binary_score = mean(binary_score)
) %>%
select(
ID,
binary_score
)
df_binary
}
extract_pl1_score <- function(df_raw) {
# Extract information about the task structure and then compute the
# score from post learning task 1 (pair)
# param  : df_raw A tibble
# return : df_pl1 A tibble
var_names <- colnames(df_raw)
var_names <- grep("stim[0-9]+_(name|pair)", var_names, value = TRUE)
df_gnomes_info <- df_raw %>%
select(
PROLIFIC_PID,
var_names
) %>%
filter(complete.cases(.)) %>%
gather(key, value, -PROLIFIC_PID) %>%
separate(key, into = c("stim_num", "variable"), sep = "_") %>%
pivot_wider(names_from = variable, values_from = value) %>%
select(PROLIFIC_PID, name, pair)
df_pl1 <- df_raw %>%
select(
