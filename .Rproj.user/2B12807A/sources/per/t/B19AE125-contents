### Fig 2.A

```{r}
df <- read.csv("../data/processed/data.csv", header = TRUE, row.names = 1)

df_plot <- df %>%
  mutate(
    gen = gen + 1,
    cond = recode(
      cond,
      "OBS" = "Observation",
      "ADV" = "Language"
    )
  ) %>%
  group_by(gen, cond) %>%
  summarize(
    mean = mean(score_corrected),
    sd = sd(score_corrected),
    n = n(),
    error_margin = qt(0.975, df = n-1) * sd / sqrt(n),
    lower_ci = mean - error_margin,
    upper_ci = mean + error_margin,
    .groups = "drop"
  ) %>%
  mutate(var = "Task Performance")

p <- df_plot %>%
  ggplot( aes(x = gen, y = mean, color = cond, fill = cond, shape = cond)) +
  geom_ribbon(aes(ymin = lower_ci, ymax = upper_ci, fill = cond), alpha = 0.2, colour = NA, show.legend = F) +
  geom_line(aes(color = cond), linewidth = 1) +
  geom_point(aes(color = cond, shape = cond), size = 5) +
  geom_hline(yintercept = 0, linetype = "dashed") +
  labs(
    x = "Generation",
    y = "Task Performance",
    shape = " ",
    colour = " "
  ) +
  scale_x_continuous(
    limits = c(0.5, 10.5),
    breaks = seq(1, 10, by = 1),
    expand = c(.001, .001)
  ) +
  scale_y_continuous(
    limits = c(-0.1, 1.5),
    breaks = seq(0, 2, by = 0.50),
    expand = c(.001, .001)
  ) +
  scale_shape_manual(values = c("Language" = 16, "Observation" = 23)) +
  scale_color_manual(
    values = c("Language" = "#FF6B6B", "Observation" = "#1A535C")
  ) +
  scale_fill_manual(values = c("Language" = "#FF6B6B", "Observation" = "#1A535C")) +
  guides(
    color = "none",
    shape = guide_legend(title = "", override.aes = list(color = c("#FF6B6B", "#1A535C"), fill = c("#FF6B6B", "#1A535C"))),
    fill = "none"
  ) +
  theme_minimal() +
  theme(
    panel.grid.minor = element_blank(),
    panel.grid.major = element_blank(),
    axis.line = element_line(colour = "black", size = .8),
    axis.ticks = element_line(colour = "black", size = .8),
    axis.ticks.length.x = unit(8, "pt"),
    axis.ticks.length.y = unit(10, "pt"),
    axis.text = element_text(size = 18, colour = "black"),
    axis.title.x = element_text(
      margin = margin(t = 10),
      size = 24
    ),
    axis.title.y = element_text(
      margin = margin(r = 10),
      size = 24
    ),
    plot.margin = margin(15, 15, 20, 15),
    legend.text = element_text(face = "bold", size = 24),
    legend.position = c(0.2, 0.7),
    legend.title = element_text(size = 24),
    title = element_text(size = 24)
  )

ggsave(
  p,
  filename = "../output/figures/manuscript/illustrator/fig2/fig2_A.pdf",
  width = 6,
