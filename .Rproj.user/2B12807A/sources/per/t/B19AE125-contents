    mutate(rew_1 = rew_1 * stake) %>%
    mutate(rew_2 = rew_2 * stake) %>%
    mutate(avg_rew = rowMeans(cbind(rew_1, rew_2))) %>%
    mutate(score = reward - avg_rew) %>%
    mutate(gen = i) %>%
    rowwise() %>%
    mutate(optimal_choice = ifelse(reward == max(rew_1, rew_2), 1, 0))
  
  df <- bind_rows(df, df_gen)
}
