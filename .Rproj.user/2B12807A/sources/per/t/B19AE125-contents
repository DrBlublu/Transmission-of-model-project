### Topic regression estimates

Task performance regression
```{r}
color_palette <- c("#F4E285", "#F4A259", "#5B8E7D", "#BC4B51", "#8CB369", "#6C5B7B")

df_NLP <- read.csv("../old/NLP/results/docs_topic_weights.csv")

data <- df_NLP %>%
  filter(gen != 0) %>%
  select(
    ID,
    pl2_understanding,
    gen,
    parent_topic_0,
    parent_topic_1,
    parent_topic_2,
    parent_topic_3,
    parent_topic_4,
    parent_topic_5
  ) %>%
  gather(key = "topic_n", value = "prop", -c(ID, pl2_understanding, gen)) %>%
  mutate(topic_n = factor(topic_n))

res <- lmer(pl2_understanding ~ prop:topic_n + (1 | gen), data = data)
tidy_reg <- tidy(res, conf.int = TRUE) %>%
  filter(term != c("(Intercept)", "sd__(Intercept)", "sd__Observation")) %>%
  mutate(topic_label = paste0("Topic ", 0:5)) %>%
  mutate(topic_label = factor(topic_label, levels = paste0("Topic ", 0:5))) %>%
  mutate(fill_col = color_palette) %>%
  mutate(term = fct_reorder(term, estimate)) %>%
  mutate(shape_col = c(11, 13, 5, 15, 6, 28))

fill_palette <- setNames(as.character(tidy_reg$fill_col), tidy_reg$topic_label)



# define a custom function
str_pad_custom <- function(labels){
  new_labels <- stringr::str_pad(labels, 10, "right")
  return(new_labels)
}



p_topic_est_TU <- tidy_reg %>%
  ggplot(aes(estimate, term, fill = topic_label, starshape = topic_label)) +
  geom_vline(xintercept = 0, lty = 2) +
  geom_errorbarh(aes(xmin = conf.low, xmax = conf.high), height = 0.2) +
  geom_star(size = 6, colour = "black") +
  scale_starshape_manual(
    values = setNames(tidy_reg$shape_col, tidy_reg$topic_label),
    labels = str_pad_custom
  ) +
  scale_fill_manual(
    values = fill_palette,
    labels = str_pad_custom
  ) +
  scale_x_continuous(
    limits = c(-1.1, 1.1),
    breaks = seq(-1, 1, by = 0.5),
    expand = c(.001, .001)
  ) +
  labs(x = "Model Knowledge Estimates", y = "", fill = "", starshape = "") +
  guides(
    fill = guide_legend(nrow = 1),
    starshape = guide_legend(nrow = 1)
  ) +
  theme_minimal() +
  theme(
    panel.grid.minor = element_blank(),
    panel.grid.major = element_blank(),
    axis.line.y = element_blank(),
    axis.text.y = element_blank(),
    axis.ticks.y = element_blank(),
    axis.line = element_line(colour = "black", size = .8),
    axis.ticks = element_line(colour = "black", size = .8),
    axis.ticks.length.x = unit(8, "pt"),
    axis.text = element_text(size = 18, colour = "black"),
    axis.title.x = element_text(
      margin = margin(t = 10),
      size = 24
    ),
    plot.margin = margin(15, 15, 20, 15),
    legend.text = element_text(face = "bold", size = 24),
    legend.position = c(0.2, 0.7),
    legend.title = element_text(size = 24),
    title = element_text(size = 20)
  )

ggsave(
  p_topic_est_TU,
  filename = "../output/figures/manuscript/illustrator/topic_TU_regression.pdf",
  width = 6,
  height = 4
)
