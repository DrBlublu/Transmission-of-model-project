process_rater_data <- function(response_path, advice_path, rater_name) {
  df_response <- read.csv(response_path)
  df_advice <- read.csv(advice_path)
  
  df_rating <- df_response %>%
    pivot_longer(
      cols = matches("Fixed\\.Pair|Gnome\\.to\\.Forest\\.Mapping|Dynamic\\.Rewards|Color\\.Belief|Irrelevent\\.Features"),
      names_to = "variable",
      values_to = "value"
    ) %>%
    mutate(
      variable = case_when(
        str_detect(variable, "Fixed\\.Pair") ~ "fixed_pair",
        str_detect(variable, "Gnome\\.to\\.Forest\\.Mapping") ~ "transition_function",
        str_detect(variable, "Dynamic\\.Rewards") ~ "dynamic_rewards",
        str_detect(variable, "Color\\.Belief") ~ "color_reward_mapping",
        str_detect(variable, "Irrelevent\\.Features") ~ "irrelevant_features"
      ),
      group = cumsum(variable == "fixed_pair")
    ) %>%
    pivot_wider(
      names_from = variable,
      values_from = value
    ) %>%
    select(fixed_pair, transition_function, color_reward_mapping, dynamic_rewards, irrelevant_features) %>%
    mutate(rater = rater_name)
  
  df_rating <- bind_cols(df_advice, df_rating) %>%
    arrange(ID)
  
  return(df_rating)
}

