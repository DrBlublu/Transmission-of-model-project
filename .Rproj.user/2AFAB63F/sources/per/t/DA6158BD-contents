# PLOT PAPER

## FIG 1 (Task Performance)

ADV/OBS Task Performance
```{r}
df_plot <- df %>%
  mutate(gen = gen + 1) %>%
  group_by(cond, gen) %>%
  summarize(
    mean = mean(score_corrected),
    sd = sd(score_corrected),
    n = n(),
    error_margin = qt(0.975, df = n-1) * sd / sqrt(n),
    lower_ci = mean - error_margin,
    upper_ci = mean + error_margin,
    .groups = "drop"
  ) %>%
  mutate(cond = factor(cond, levels = c("ADV", "OBS")))

plot_AO_P <- df_plot %>%
  ggplot( aes(x = gen, y = mean, color = cond, fill = cond, shape = cond)) +
  geom_hline(yintercept = 0, linetype = "dashed", color = "black", linewidth = 0.8) +
  geom_ribbon(aes(ymin = lower_ci, ymax = upper_ci, fill = cond), alpha = 0.2, colour = NA, show.legend = F) +
  geom_line(aes(color = cond), linewidth = 1) +
  geom_point(aes(color = cond, shape = cond), size = 5) +
  labs(
    x = "Generation",
    y = "Task Performance",
    shape = " ",
    colour = " "
  ) +
  scale_x_continuous(
    limits = c(0.5, 10.5),
    breaks = seq(1, 10, by = 1),
    expand = c(.001, .001)
  ) +
  scale_y_continuous(
    limits = c(-0.25, 1.75),
    breaks = seq(0, 2, by = 0.5),
    expand = c(.001, .001)
  ) +
  scale_shape_manual(values = c("ADV" = 16, "OBS" = 23)) +
  scale_color_manual(
    values = c("ADV" = "#FF6B6B", "OBS" = "#1A535C"),
    labels = c("Language", "Observation")
  ) +
  scale_fill_manual(values = c("ADV" = "#FF6B6B", "OBS" = "#1A535C")) +
  guides(
    color = guide_legend(title = "Treatment", override.aes = list(shape = c(16, 23), fill = c("#FF6B6B", "#1A535C"))),
    shape = "none",
    fill = "none"
  ) +
  theme_minimal() +
  theme(
    panel.grid.minor = element_blank(),
    panel.grid.major = element_blank(),
    axis.line = element_line(colour = "black", size = .8),
    axis.ticks = element_line(colour = "black", size = .8),
    axis.ticks.length.x = unit(5, "pt"),
    axis.ticks.length.y = unit(7, "pt"),
    axis.text = element_text(size = 11, colour = "black"),
    axis.title.x = element_text(
      margin = margin(t = 10),
      size = 16
    ),
    axis.title.y = element_text(
      margin = margin(r = 10),
      size = 16
    ),
    plot.margin = margin(15, 15, 20, 15),
    legend.text = element_text(face = "bold", size = 16),
    legend.position = c(0.2, 0.7),
    legend.title = element_text(size = 16)
  )

plot_AO_P
```

ADV/OBS first Task Performance
```{r}
df_plot <- df %>%
  mutate(group = ifelse(gen <= 2, "First 3 generations", ifelse(gen >= 7, "Last 3 generations", 0))) %>%
    filter(group != 0) %>%
  filter(group == "First 3 generations") %>%
  group_by(cond) %>%
  summarise(
    score_mean = mean(score_corrected)
  )


adv_sig_line <- df_plot$score_mean[df_plot$cond == "ADV"] + 0.05
obs_sig_line <- df_plot$score_mean[df_plot$cond == "OBS"] + 0.05
top_sig_line <- max(adv_sig_line, obs_sig_line) + 0.1


plot_AO_P_first <- df_plot %>%
  ggplot(aes(x = cond, y = score_mean)) +
  geom_col(
    color = c("#FF6B6B", "#1A535C"),
    fill = "white",
    alpha = .7,
    linewidth = 1.5
  ) +
  
  geom_line(
    data = tibble(
      x = c("ADV", "ADV", "OBS", "OBS"),
      y = c(adv_sig_line, top_sig_line, top_sig_line, obs_sig_line)
    ),
    aes(x = x, y = y, group = 1),
    size = 1
  ) +
  annotate(
    "text",
    x = 1.5,
    y = top_sig_line + 0.14,
    label = "n.s.",
    size = 8
  ) +

  
  scale_y_continuous(
    limits = c(0, 1.4),
    breaks = c(0, 0.5, 1),
    expand = c(0, 0)
  ) +

  labs(
    y = "Task Performance"
  ) +
  scale_x_discrete(labels = c("Language", "Observation")) +
  theme_minimal() +
  theme(
    panel.grid.minor = element_blank(),
    panel.grid.major = element_blank(),
    plot.margin = margin(15, 15, 10, 15),
    legend.position = "none",
    axis.text = element_text(size = 11, colour = "black"),
    axis.line.y = element_line(colour = "black", size = .8),
    axis.ticks.y = element_line(colour = "black", size = .8),
    axis.ticks.length.y = unit(7, "pt"),
    axis.title.y = element_text(
      margin = margin(r = 10),
      size = 16
    ),
    axis.text.x = element_text(size = 16, colour = "black"),
    axis.line.x = element_blank(),
    axis.title.x = element_blank(),
    axis.ticks.x = element_blank()
  )

