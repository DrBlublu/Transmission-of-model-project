y_name <- "Pair understanding"

# Data Preparation
df_plot <- df %>%
  select(ID, all_of(y_var), gen, cond) %>%
  mutate(gen = gen + 1) %>%
  rename(y_value = all_of(y_var))  # Rename the selected variable for easier plotting

# Confidence Interval Calculation
df_plot <- df_plot %>%
  group_by(cond, gen) %>%
  summarize(
    mean = mean(y_value),
    sd = sd(y_value),
    n = n(),
    error_margin = qt(0.975, df = n-1) * sd / sqrt(n),
    lower_ci = mean - error_margin,
    upper_ci = mean + error_margin,
    .groups = "drop"
  )

# Dynamic Plot
ggplot(df_plot, aes(x = gen, y = mean, color = cond, group = cond)) +
  geom_ribbon(aes(ymin = lower_ci, ymax = upper_ci, fill = cond), alpha = 0.2, colour = NA, show.legend = F) +
  geom_line(linewidth = 1) +
  geom_errorbar(aes(ymin = lower_ci, ymax = upper_ci), width = 0.2, alpha = 0.9) +
  geom_point(aes(shape = cond), size = 5) +
  labs(
    x = "Generation Number",
    y = paste(y_name),  # Dynamically update y-axis label
    shape = " ",
    colour = " "
  ) +
  scale_x_continuous(
    limits = c(min(df_plot$gen) - 0.5, max(df_plot$gen) + 0.5),
    breaks = seq(min(df_plot$gen), max(df_plot$gen), by = 1),
    expand = c(.001, .001)
  ) +
  scale_y_continuous(
    limits = c(min(df_plot$lower_ci), max(df_plot$upper_ci)),
    expand = c(.05, .05)  # Automatically adjust y-axis limits
  ) +
  guides(shape = guide_legend(override.aes = list(linetype = 0))) +
  theme_minimal() +
  theme(
    panel.grid.minor = element_blank(),
    panel.grid.major = element_blank(),
    axis.line = element_line(colour = "black", size = .8),
    axis.ticks = element_line(colour = "black", size = .8),
    axis.ticks.length.x = unit(5, "pt"),
    axis.ticks.length.y = unit(7, "pt"),
    axis.text = element_text(family = "Roboto Mono", size = 11, colour = "black"),
    axis.title.x = element_text(
      margin = margin(t = 10),
      size = 16
    ),
    axis.title.y = element_text(
      margin = margin(r = 10),
      size = 16
    ),
    plot.margin = margin(15, 15, 10, 15),
    legend.position = c(.1, .8),
    legend.text = element_text(face = "bold", size = 12)
  )

# Save Output
ggsave(paste0("../output/figures/", y_name, ".tiff"), bg = "white")
