## Adice fidelity

data loading + transformation to get parents' assigned topic
```{r}
df_NLP <- read.csv("../old/NLP/results/docs_topic_weights.csv")

df_NLP <- tibble(df_NLP)

parent_assigned_topic <- rep(NA, nrow(df_NLP)) # Pre-fill with NAs

for (i in 1:nrow(df_NLP)){
  parent_ID <- df_NLP[i,]$parent_ID
  parent <- df_NLP %>% filter(ID == !!parent_ID) 
  parent_assigned_topic[i] <- ifelse(nrow(parent) > 0, parent$assigned_topic, NA)
}

df_NLP <- df_NLP %>%
  mutate(parent_assigned_topic = parent_assigned_topic)
```


Transmission fidelity
```{r}
df_NLP <- df_NLP %>%
  mutate(same_topic = ifelse(assigned_topic == parent_assigned_topic, TRUE, FALSE))

df_same_topic <- df_NLP %>%
  filter(gen != 1) %>% #skip first gen with no parents
  group_by(gen) %>%
  summarise(count = sum(same_topic))

ggplot(df_same_topic, aes(x = gen, y = count)) +
  geom_col(fill = "grey") +
  labs(
    x = "Generation",
    y = "n",
    title = "Children whose advice matches that of their parents"
  ) +
  theme_minimal()

df_same_topic
summary(df_same_topic$count)
```


