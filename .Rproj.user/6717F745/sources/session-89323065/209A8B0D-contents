  select(ID, all_of(y_var), gen, cond) %>%
  mutate(gen = gen + 1) %>%
  rename(y_value = all_of(y_var))  # Rename the selected variable for easier plotting

# Confidence Interval Calculation
df_plot <- df_plot %>%
  group_by(cond, gen) %>%
  summarize(
    mean = mean(y_value),
    sd = sd(y_value),
    n = n(),
    error_margin = qt(0.975, df = n-1) * sd / sqrt(n),
    lower_ci = mean - error_margin,
    upper_ci = mean + error_margin,
    .groups = "drop"
  )

# Dynamic Plot
ggplot(df_plot, aes(x = gen, y = mean, color = cond, group = cond)) +
  geom_ribbon(aes(ymin = lower_ci, ymax = upper_ci, fill = cond), alpha = 0.2, colour = NA, show.legend = F) +
  geom_line(linewidth = 1) +
  geom_errorbar(aes(ymin = lower_ci, ymax = upper_ci), width = 0.2, alpha = 0.9) +
