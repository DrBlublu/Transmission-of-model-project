## FIG 2 (Task & Transition)

```{r}
df_perf <- df %>%
  mutate(gen = gen + 1) %>%
  group_by(cond, gen) %>%
  summarize(
    mean = mean(score_corrected),
    sd = sd(score_corrected),
    n = n(),
    error_margin = qt(0.975, df = n-1) * sd / sqrt(n),
    lower_ci = mean - error_margin,
    upper_ci = mean + error_margin,
    .groups = "drop"
  ) %>%
  mutate(cond = factor(cond, levels = c("ADV", "OBS"))) %>%
  mutate(var = "PERF")

df_knowledge <- df %>%
  mutate(gen = gen + 1) %>%
  group_by(cond, gen) %>%
  summarize(
    mean = mean(pl2_understanding),
    sd = sd(pl2_understanding),
    n = n(),
    error_margin = qt(0.975, df = n-1) * sd / sqrt(n),
    lower_ci = mean - error_margin,
    upper_ci = mean + error_margin,
    .groups = "drop"
  ) %>%
  mutate(cond = factor(cond, levels = c("ADV", "OBS"))) %>%
  mutate(var = "KNOWLEDGE")


perf_range <- c(-0.25, 1.75)
knowledge_range <- c(-0.2, 1)

scale_factor <- diff(perf_range) / diff(knowledge_range)
offset <- perf_range[1] - knowledge_range[1] * scale_factor

df_knowledge <- df_knowledge %>%
  mutate(mean = mean * scale_factor + offset)

inverse_transform <- function(x) (x - offset) / scale_factor
df_plot <- bind_rows(df_perf, df_knowledge)
```


```{r}
fig2 <- df_plot %>%
  ggplot(aes(x = gen, y = mean, color = cond, fill = cond, shape = var)) +
  geom_line(linewidth = 1) +
  geom_point(size = 5) +
  geom_hline(yintercept = 0, linetype = "dashed", color = "black", linewidth = 0.8) +
  scale_x_continuous(
    limits = c(0.5, 10.5),
    breaks = seq(1, 10, by = 1),
    expand = c(.001, .001)
  ) +
  labs(
    x = "Generation",
    y = "Task Performance",
    shape = " ",
    colour = " "
  ) +
  scale_y_continuous(
    limits = perf_range,
    breaks = seq(-1, 2, by = 0.5),
    expand = c(.001, .001),
    sec.axis = sec_axis(
      trans = ~ inverse_transform(.),
      name = "Model Knowledge",
      breaks = seq(-1, 1, by = 0.5)
    )
  ) +
  scale_shape_manual(
    values = c("PERF" = 16, "KNOWLEDGE" = 23),
    labels = c("Model Knowledge", "Task Performance")
  ) +
  scale_color_manual(
    values = c("ADV" = "#FF6B6B", "OBS" = "#1A535C"),
    labels = c("Language", "Observation")
  ) +
  scale_fill_manual(
    values = c("ADV" = "#FF6B6B", "OBS" = "#1A535C"),
    labels = c("Language", "Observation")
  ) +
  guides(
    color = guide_legend(title = "", override.aes = list(fill = c("#FF6B6B", "#1A535C")), shape = "square"),
    shape = guide_legend(title = "", override.aes = list(fill = "black")),
    fill = "none"
  ) +
  theme_minimal() +
  theme(
    panel.grid.minor = element_blank(),
    panel.grid.major = element_blank(),
    axis.line = element_line(colour = "black", size = .8),
    axis.ticks = element_line(colour = "black", size = .8),
    axis.ticks.length.x = unit(5, "pt"),
    axis.ticks.length.y = unit(7, "pt"),
    axis.text = element_text(size = 11, colour = "black"),
    axis.title.x = element_text(
      margin = margin(t = 10),
      size = 16
    ),
    axis.title.y = element_text(
      margin = margin(r = 10),
      size = 16
    ),
    plot.margin = margin(15, 15, 20, 15),
    legend.text = element_text(face = "bold", size = 16),
    legend.position = "bottom",
    legend.title = element_text(size = 16)
  )

