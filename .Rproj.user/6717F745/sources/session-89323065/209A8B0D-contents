```{r}
df_plot <- df %>%
  mutate(group = ifelse(gen <= 2, "First 3 generations", ifelse(gen >= 7, "Last 3 generations", 0))) %>%
    filter(group != 0) %>%
  filter(group == "First 3 generations") %>%
  group_by(cond) %>%
  summarise(
    score_mean = mean(score_corrected)
  )


adv_sig_line <- df_plot$score_mean[df_plot$cond == "ADV"] + 0.05
obs_sig_line <- df_plot$score_mean[df_plot$cond == "OBS"] + 0.05
top_sig_line <- max(adv_sig_line, obs_sig_line) + 0.1


plot_AO_P_first <- df_plot %>%
  ggplot(aes(x = cond, y = score_mean)) +
  geom_col(
    color = c("#FF6B6B", "#1A535C"),
    fill = "white",
    alpha = .7,
    linewidth = 1.5
  ) +
  
  geom_line(
    data = tibble(
      x = c("ADV", "ADV", "OBS", "OBS"),
      y = c(adv_sig_line, top_sig_line, top_sig_line, obs_sig_line)
    ),
    aes(x = x, y = y, group = 1),
    size = 1
  ) +
  annotate(
    "text",
    x = 1.5,
    y = top_sig_line + 0.14,
    label = "n.s.",
    size = 8
  ) +

  
  scale_y_continuous(
