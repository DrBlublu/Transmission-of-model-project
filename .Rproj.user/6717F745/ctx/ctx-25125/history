library(reshape2)
df <- read.csv("../output/processed/similarity_matrix.csv", header = FALSE)
df_name <- read.csv("../output/processed/data_stakes_fitting.csv") %>%
select(ID)
rownames(df) <- df_name$ID
colnames(df) <- df_name$ID
df_similarity <- melt(df, variable.name = "s1") %>%
mutate(s2 = rep(df_name$ID, 1000)) %>%
mutate(s1_gen = rep(c(1:10), each = 100000)) %>%
mutate(s2_gen = rep(c(1:10), each = 100, 1000))
df_similarity_gen <- df_similarity %>%
mutate(gen = ifelse(s1_gen == s2_gen, s1_gen, 0)) %>%
filter(gen != 0) %>%
select(-s1_gen, -s2_gen) %>%
group_by(gen) %>%
summarise(similarity = mean(value))
View(df_similarity_gen)
View(df)
split_numbers <- function(x) {
numbers <- c(10, 1:9)
result <- str_extract_all(x, paste(numbers, collapse = "|"))[[1]]
result
}
df_plot <- df_similarity %>%
mutate(gen = paste0(as.character(s1_gen), as.character(s2_gen))) %>%
group_by(gen) %>%
summarise(similarity = mean(value)) %>%
mutate(split = map(gen, split_numbers)) %>%
unnest(split) %>%
select(-gen) %>%
mutate(group = rep(1:(n()/2), each = 2)) %>%
group_by(group) %>%
mutate(pair_id = row_number()) %>%
pivot_wider(names_from = pair_id, values_from = split, names_prefix = "s") %>%
ungroup() %>%
select(similarity, s1 = s1, s2 = s2) %>%
mutate(s1 = factor(s1, levels = c(1:10))) %>%
mutate(s2 = factor(s2, levels = c(1:10)))
plot <- df_plot %>%
ggplot(aes(x = s1, y = s2, fill = similarity)) +
geom_tile() +
labs(
title = "Similarity between generation",
x = "Generation",
y = "Generation"
)
plot
