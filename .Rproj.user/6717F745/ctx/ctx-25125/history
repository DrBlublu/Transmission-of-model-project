library(tidytext)
df_NLP <- read.csv("../old/NLP/results/docs_topic_weights.csv")
text_df <- tibble(
ID = df_NLP$ID,
gen = as.factor(df_NLP$gen),
text = df_NLP$ADVICE
)
tidy_text_df <- text_df %>%
unnest_tokens(
word,
text,
token = "regex",
pattern = "\\s+|[[:punct:]+\\-><]"
) %>%
anti_join(get_stopwords(language = "en", source = "snowball")) %>%
# remove token that are 1 chr or purely number
filter(!str_detect(word, "$[0-9]+$")) %>%
filter(nchar(word) > 1)
count_text_df <- tidy_text_df %>%
group_by(ID) %>%
summarize(
n = n(),
gen = unique(gen)
)
df_count <- right_join(df_NLP, count_text_df %>% select(-gen), by = "ID") %>%
rename(n_word = n)
df_adv_size <- df_count %>%
select(
ID,
gen,
ADVICE,
n_word,
assigned_topic
) %>%
rowwise() %>%
mutate(n_chr = nchar(ADVICE))
