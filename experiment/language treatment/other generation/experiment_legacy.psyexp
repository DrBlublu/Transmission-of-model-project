        <Param val="t_step1_bg_img.setAutoDraw(true);&amp;#10;t_step1_leftStim_img.setAutoDraw(true);&amp;#10;t_step1_rightStim_img.setAutoDraw(true);&amp;#10;t_step1_scoreBg_img.setAutoDraw(true);&amp;#10;t_step1_score_txt.setAutoDraw(true);&amp;#10;" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="t_step1_bg_img.setAutoDraw(True)&amp;#10;t_step1_leftStim_img.setAutoDraw(True)&amp;#10;t_step1_rightStim_img.setAutoDraw(True)&amp;#10;t_step1_scoreBg_img.setAutoDraw(True)&amp;#10;t_step1_score_txt.setAutoDraw(True)&amp;#10;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="JS" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
