df_NLP <- read.csv("../results/NLP/data_topic_weights.csv")
df_plot <- df_NLP %>%
filter(assigned_topic != -1) %>%
mutate(assigned_topic = as.character(assigned_topic)) %>%
group_by(gen, assigned_topic) %>%
summarise(entry_count = n())
df_popsize <- df_plot %>%
group_by(gen) %>%
summarise(n = sum(entry_count))
df_plot <- left_join(df_plot, df_popsize, by = "gen") %>%
mutate(pop_percent = (entry_count / n) * 100)
color_palette <- c(
"#F4E285",
"#F4A259",
"#5B8E7D",
"#BC4B51",
"#8CB369",
"#6C5B7B",
"#3A86FF",
"#8338EC",
"#FF006E",
"#FFBE0B"
)
shape_palette <-  c(11, 13, 5, 15, 6, 28, 1, 2, 3, 4)
# Plot with gradient coloring based on similarity score
p_evo_topic <- df_plot %>%
ggplot(aes(
x = gen,
y = pop_percent,
group = assigned_topic,
color = assigned_topic,
starshape = assigned_topic,
fill = assigned_topic
)
) +
geom_line(linewidth = 1) +
geom_star(size = 2) +
scale_starshape_manual(values = shape_palette) +
scale_color_manual(values = color_palette) +
scale_fill_manual(values = color_palette) +
scale_x_continuous(limits = c(0.5, 10.5), breaks = seq(1, 10, by = 1), expand = c(0.001, 0.001)) +
scale_y_continuous(limits = c(0, 55), breaks = seq(0, 50, by = 10), expand = c(0.001, 0.001)) +
labs(y = "% of population", x = "Generation") +
theme_minimal() +
theme(
panel.grid.minor = element_blank(),
panel.grid.major = element_blank(),
axis.line = element_line(colour = "black", size = .8),
axis.ticks = element_line(colour = "black", size = .8),
axis.ticks.length.x = unit(8, "pt"),
axis.ticks.length.y = unit(10, "pt"),
axis.text = element_text(size = 18, colour = "black"),
axis.title.x = element_text(
margin = margin(t = 10),
size = 24
),
axis.title.y = element_text(
margin = margin(r = 10),
size = 24
),
plot.margin = margin(15, 15, 20, 15),
legend.position = "top"
)
