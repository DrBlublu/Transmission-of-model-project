library(ggplotify)
library(fmsb)
# First six user-defined colors
colors_border <- c(
"#F4E285", "#F4A259", "#5B8E7D", "#BC4B51", "#8CB369", "#6C5B7B"
)
colors_in <- c(
adjustcolor("#F4E285", alpha.f = 0.4),
adjustcolor("#F4A259", alpha.f = 0.4),
adjustcolor("#5B8E7D", alpha.f = 0.4),
adjustcolor("#BC4B51", alpha.f = 0.4),
adjustcolor("#8CB369", alpha.f = 0.4),
adjustcolor("#6C5B7B", alpha.f = 0.4)
)
# Add invented colors if needed
extra_colors <- c("#3C91E6", "#DB5461", "#FFB400", "#6CA6CD", "#A0522D")
colors_border <- c(colors_border, extra_colors)
colors_in <- c(colors_in, adjustcolor(extra_colors, alpha.f = 0.4))
# Summarize data
df_plot <- df %>%
filter(cond == "ADV") %>%
filter(assigned_topic != -1) %>%
select(gen, assigned_topic, starts_with("llm")) %>%
group_by(assigned_topic) %>%
summarise(
`Fixed pair` = mean(llm_fixed_pair),
`State transitions` = mean(llm_transition_function),
`Dynamic rewards` = mean(llm_dynamic_rewards),
`Color reward mapping` = mean(llm_color_reward_mapping),
`Irrelevant features` = mean(llm_irrelevant_features)
) %>%
ungroup()
# Generate radar charts for each topic except -1
plots <- list()
topics <- df_plot$assigned_topic[df_plot$assigned_topic != -1]
for (i in seq_along(topics)) {
topic_val <- topics[i]
topic_data <- df_plot %>% filter(assigned_topic == topic_val) %>% select(-assigned_topic)
chart_data <- rbind(rep(2, 5), rep(0, 5), topic_data)
# Create radar chart and convert to ggplot object
radar_plot <- as.ggplot(function() {
par(mar = c(2, 2, 4, 2))  # bottom, left, top, right
radarchart(
chart_data,
axistype = 0,
pcol = colors_border[i],
pfcol = colors_in[i],
plwd = 4,
plty = 1,
cglcol = "grey",
cglty = 1,
axislabcol = "grey",
caxislabels = seq(0, 2, 1),
cglwd = 0.8,
vlcex = 1,
title = paste("Topic", topic_val)
)
}) +
theme(plot.margin = margin(10, 10, 10, 10))
plots[[i]] <- radar_plot
}
# Combine all radar charts using patchwork
merged_plot <- wrap_plots(plots, ncol = 3)
merged_plot
