color_palette <- c("#2D7DD2","#EEB902","#97CC04","#F45D01")
shape_palette <-  c(11, 13, 5, 15)
df_good_topic <- df %>%
filter(cond == "ADV" & assigned_topic %in% c(2, 4))
df_plot <- df_good_topic %>%
select(
ID,
gen,
assigned_topic,
starts_with("llm_")
) %>%
filter(assigned_topic < 6 & assigned_topic != -1) %>%
pivot_longer(cols = starts_with("llm_"), names_to = "criterion_name", values_to = "criterion") %>%
mutate(criterion_name = sub(".*llm_", "", criterion_name)) %>%
group_by(gen, criterion_name) %>%
summarise(
criterion = mean(criterion)
) %>%
filter(criterion_name != "fixed_pair") %>%
mutate(criterion_name = str_replace_all(criterion_name, c(
"color_reward_mapping" = "Color reward mapping",
"dynamic_rewards" = "Dynamic rewards",
"irrelevant_features" = "Irrelevant features",
"transition_function" = "State transitions"
)))
fig4A <- df_plot %>%
ggplot(aes(
x = gen,
y = criterion,
group = criterion_name,
color = factor(criterion_name),
starshape = factor(criterion_name),
fill = factor(criterion_name)
)
) +
geom_line(linewidth = 1) +
geom_star(size = 2) +
scale_starshape_manual(values = shape_palette) +
scale_color_manual(values = color_palette) +
scale_fill_manual(values = color_palette) +
scale_x_continuous(limits = c(1, 10), breaks = seq(1, 10, by = 1), expand = c(0.001, 0.001)) +
scale_y_continuous(limits = c(0, 2), breaks = seq(0, 2, by = 1), expand = c(0.001, 0.001)) +
labs(y = "Rating", x = "Generation") +
theme_minimal() +
theme(
panel.grid.minor = element_blank(),
panel.grid.major = element_blank(),
axis.line = element_line(colour = "black", size = .8),
axis.ticks = element_line(colour = "black", size = .8),
axis.ticks.length.x = unit(8, "pt"),
axis.ticks.length.y = unit(10, "pt"),
axis.text = element_text(size = 18, colour = "black"),
axis.title.x = element_text(
margin = margin(t = 10),
size = 24
),
axis.title.y = element_text(
margin = margin(r = 10),
size = 24
),
plot.margin = margin(15, 15, 20, 15),
legend.position = "bottom",
legend.text = element_text(face = "bold", size = 15),
legend.title = element_blank()
)
fig4A
