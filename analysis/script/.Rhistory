df_plot <- df %>%
mutate(
gen = gen + 1,
cond = recode(
cond,
"OBS" = "Observation",
"ADV" = "Language"
)
) %>%
filter(gen %in% c(1, 10)) %>%
group_by(cond, gen) %>%
summarise(
task_performance = mean(score_corrected)
)
plot_SM_213 <- ggplot(df_plot, aes(x = as.factor(gen), y = task_performance, fill = cond)) +
geom_bar(stat = "identity", position = "dodge") +
geom_segment(
aes(x = 0.75, xend = 1.25, y = 0.37, yend = 0.37),
inherit.aes = FALSE
) +
geom_text(
aes(x = 1, y = 0.45, label = "ns"),
inherit.aes = FALSE, size = 6
) +
geom_segment(
aes(x = 1.75, xend = 2.25, y = 1.13, yend = 1.13),
inherit.aes = FALSE
) +
geom_text(
aes(x = 2, y = 1.15, label = "*"),
inherit.aes = FALSE, size = 6
) +
scale_y_continuous(
limits = c(0, 1.3),
breaks = c(0, 0.5, 1),
expand = c(0, 0)
) +
labs(
x = "Generation",
y = "Task performance"
) +
scale_fill_manual(values = c("Language" = "#FF6B6B", "Observation" = "#1A535C")) +
theme_minimal() +
theme(
panel.grid.minor        = element_blank(),
panel.grid.major        = element_blank(),
axis.line               = element_line(colour = "black", size = .8),
axis.ticks              = element_line(colour = "black", size = .8),
axis.ticks.length.x     = unit(8, "pt"),
axis.ticks.length.y     = unit(10, "pt"),
axis.text               = element_text(size = 12, colour = "black"),
axis.title.x            = element_text(margin = margin(t = 10), size = 18),
axis.title.y            = element_text(margin = margin(r = 10), size = 18),
plot.margin             = margin(15, 15, 20, 15),
legend.text             = element_text(face = "bold", size = 18),
legend.position         = "top",
legend.title            = element_blank(),
title                   = element_text(size = 18)
)
