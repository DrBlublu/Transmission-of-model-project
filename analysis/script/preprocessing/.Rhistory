df <- read.csv("../data/data_participants.csv", row.names = 1)
# RL data
df_w_language <- read.csv("../data/data_rl_language.csv", row.names = 1)
df_w_observation <- read.csv("../data/data_rl_observation.csv", row.names = 1)
df_w <- bind_rows(
df_w_language %>% mutate(cond = "ADV"),
df_w_observation %>% mutate(cond = "OBS")
) %>%
dplyr::select(ID, cond, w)
# BERTopic data
df_bertopic <- read.csv("../data/data_bertopic.csv")
df_bertopic <- df_bertopic %>%
mutate(gen = gen -1)
# LLM data
df_llm <- read.csv(
"../data/data_llm.csv",
header = TRUE
)
df_llm <- df_llm %>%
group_by(ID) %>%
summarise(
llm_fixed_pair = mean(fixed_pair, na.rm = TRUE),
llm_transition_function = mean(transition_function, na.rm = TRUE),
llm_dynamic_rewards = mean(dynamic_rewards, na.rm = TRUE),
llm_color_reward_mapping = mean(color_reward_mapping, na.rm = TRUE),
llm_irrelevant_features = mean(irrelevant_features, na.rm = TRUE)
)
# Combining all df
df <- df %>% left_join(df_w, by = c("ID", "cond"))
df$cond <- factor(df$cond)
df$cond <- relevel(df$cond, ref = "OBS")
df <- df %>%
left_join(
df %>% dplyr::select(ID, w) %>% rename(parent_w = w),
by = c("parent_ID" = "ID")
)
df <- left_join(df, df_llm, by = "ID")
df <- df %>%
left_join(
df %>% dplyr::select(ID, llm_fixed_pair, llm_transition_function,
llm_dynamic_rewards, llm_color_reward_mapping,
llm_irrelevant_features) %>%
rename(parent_llm_fixed_pair = llm_fixed_pair,
parent_llm_transition_function = llm_transition_function,
parent_llm_dynamic_rewards = llm_dynamic_rewards,
parent_llm_color_reward_mapping = llm_color_reward_mapping,
parent_llm_irrelevant_features = llm_irrelevant_features),
by = c("parent_ID" = "ID")
)
df <- left_join(
df,
df_bertopic %>%
select(
ID,
starts_with("topic"),
starts_with("parent_topic")
),
by = "ID"
)
rm(df_bertopic, df_llm, df_w, df_w_language, df_w_observation)
df_human_advice_rating <- read.csv("../data/data_human_advice_rating.csv")
df_llm <- df %>%
mutate(a = gen - lag(gen, default = FALSE)) %>%
mutate(new_llm = cumsum(lag(a < 0, default = FALSE)) + 1) %>%
mutate(new_llm = ifelse(a < 0, new_llm + 1, new_llm))
View(df_llm)
df_transition_llm <- df_llm %>%
select(ID, gen, new_llm, transition_function) %>%
pivot_wider(
names_from = new_llm,
values_from = transition_function,
names_glue = "llm_{new_llm}")
df_llm <- read.csv("../data/data_llm.csv")
df_llm <- df %>%
mutate(a = gen - lag(gen, default = FALSE)) %>%
mutate(new_llm = cumsum(lag(a < 0, default = FALSE)) + 1) %>%
mutate(new_llm = ifelse(a < 0, new_llm + 1, new_llm))
df_llm <- df_llm %>%
mutate(a = gen - lag(gen, default = FALSE)) %>%
mutate(new_llm = cumsum(lag(a < 0, default = FALSE)) + 1) %>%
mutate(new_llm = ifelse(a < 0, new_llm + 1, new_llm))
df_human_advice_rating <- read.csv("../data/data_human_advice_rating.csv")
df_llm <- read.csv("../data/data_llm.csv")
df_llm <- df_llm %>%
mutate(a = gen - lag(gen, default = FALSE)) %>%
mutate(new_llm = cumsum(lag(a < 0, default = FALSE)) + 1) %>%
mutate(new_llm = ifelse(a < 0, new_llm + 1, new_llm))
View(df_llm)
df_transition_llm <- df_llm %>%
select(ID, gen, new_llm, transition_function) %>%
pivot_wider(
names_from = new_llm,
values_from = transition_function,
names_glue = "llm_{new_llm}")
df_transition_human <- df_rating %>%
select(ID, gen, transition_function, rater) %>%
pivot_wider(
names_from = rater,
values_from = transition_function
)
View(df_transition_llm)
df_transition_llm <- df_llm %>%
select(ID, gen, new_llm, transition_function) %>%
pivot_wider(
names_from = new_llm,
values_from = transition_function,
names_glue = "llm_{new_llm}")
df_transition_human <- df_human_advice_rating %>%
select(ID, gen, transition_function, rater) %>%
pivot_wider(
names_from = rater,
values_from = transition_function
)
df_transition <- left_join(df_transition_human, df_transition_llm %>% select(-gen), by = c("ID"))
# HUMAN
icc(
df_transition %>% select(-ID, -gen, -starts_with("llm")),
model = "twoway",
type = "agreement"
)
# LLM
icc(
df_transition %>% select(starts_with("llm")),
model = "twoway",
type = "agreement"
)
# HUMAN + LLM
icc(
df_transition %>% select(-ID, -gen),
model = "twoway",
type = "agreement"
)
icc(
df_transition %>% select(-ID, -gen),
model = "twoway",
type = "consistency"
)
